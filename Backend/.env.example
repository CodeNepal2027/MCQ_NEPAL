# ============================================
# DJANGO ENVIRONMENT VARIABLES
# ============================================

# Django Settings
DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=True

# Production Flag - Set to True for production, False for development
PRODUCTION=True

# Allowed Hosts (comma separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Language and Timezone
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kathmandu

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Production Database (MySQL) - Used when PRODUCTION=True
DB_ENGINE=django.db.backends.mysql
DB_NAME=your-db-password-name
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Development Database (SQLite) - Used when PRODUCTION=False
# SQLite is automatically configured in settings.py

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://codenepal.com.np,https://www.codenepal.com.np

# ============================================
# API CONFIGURATION
# ============================================

API_VERSION=v1